<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h3 class="mb-1"><%= project.name %></h3>
    <p class="text-muted mb-0">Created by <%= project.creator.name %></p>
  </div>
  <div>
    <% if (currentUser.role === 'Admin' || currentUser.role === 'Manager') { %>
      <a href="/projects/<%= project.id %>/edit" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
    <% } %>
    <a href="/projects" class="btn btn-outline-secondary btn-sm">Back</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-8">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h6>Description</h6>
        <p><%= project.description || 'No description provided.' %></p>
        <div class="row">
          <div class="col-6"><strong>Start Date:</strong> <%= project.startDate %></div>
          <div class="col-6"><strong>End Date:</strong> <%= project.endDate || 'TBD' %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h6>Status</h6>
        <% if (currentUser.role === 'Admin' || currentUser.role === 'Manager') { %>
          <form action="/projects/<%= project.id %>/status?_method=PATCH" method="POST" class="d-flex gap-2">
            <select name="status" class="form-select form-select-sm">
              <% ['Pending', 'In Progress', 'Completed'].forEach(function(s) { %>
                <option value="<%= s %>" <%= project.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
            <button class="btn btn-sm btn-primary">Update</button>
          </form>
        <% } else { %>
          <span class="badge bg-primary"><%= project.status %></span>
        <% } %>

        <h6 class="mt-3">Assigned Employees</h6>
        <% if (project.assignedEmployees.length === 0) { %>
          <p class="text-muted small">No employees assigned yet.</p>
        <% } %>
        <ul class="list-unstyled mb-0">
          <% project.assignedEmployees.forEach(function(e) { %>
            <li><i class="bi bi-person-circle me-1"></i><%= e.name %></li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h5 class="mb-0">Tasks</h5>
  <% if (currentUser.role === 'Admin' || currentUser.role === 'Manager') { %>
    <a href="/tasks/new" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>New Task</a>
  <% } %>
</div>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead class="table-light">
        <tr><th>Title</th><th>Assignee</th><th>Priority</th><th>Due Date</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% if (project.tasks.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-3">No tasks yet.</td></tr>
        <% } %>
        <% project.tasks.forEach(function(t) { %>
          <tr>
            <td><%= t.title %></td>
            <td><%= t.assignee ? t.assignee.name : 'Unassigned' %></td>
            <td><%= t.priority %></td>
            <td><%= t.dueDate || '—' %></td>
            <td><span class="badge bg-secondary"><%= t.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
