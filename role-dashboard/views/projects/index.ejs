<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Projects</h3>
  <% if (currentUser.role === 'Admin' || currentUser.role === 'Manager') { %>
    <a href="/projects/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Project</a>
  <% } %>
</div>

<form class="row g-2 mb-3" method="GET" action="/projects">
  <div class="col-auto">
    <input type="text" name="search" value="<%= search %>" class="form-control" placeholder="Search by name...">
  </div>
  <div class="col-auto">
    <select name="status" class="form-select">
      <option value="">All statuses</option>
      <% ['Pending', 'In Progress', 'Completed'].forEach(function(s) { %>
        <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto">
    <button class="btn btn-outline-secondary" type="submit">Filter</button>
  </div>
</form>

<div class="row g-3">
  <% if (projects.length === 0) { %>
    <p class="text-muted">No projects found.</p>
  <% } %>
  <% projects.forEach(function(p) { %>
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-start">
            <h5 class="card-title"><%= p.name %></h5>
            <% const badgeClass = p.status === 'Completed' ? 'bg-success' : p.status === 'In Progress' ? 'bg-primary' : 'bg-warning'; %>
            <span class="badge <%= badgeClass %>"><%= p.status %></span>
          </div>
          <p class="card-text text-muted small flex-grow-1"><%= (p.description || '').slice(0, 100) %><%= p.description && p.description.length > 100 ? '…' : '' %></p>
          <p class="small mb-1"><i class="bi bi-calendar3 me-1"></i><%= p.startDate %> &rarr; <%= p.endDate || 'TBD' %></p>
          <p class="small mb-2"><i class="bi bi-people me-1"></i><%= p.assignedEmployees.length %> employee(s) assigned</p>
          <a href="/projects/<%= p.id %>" class="btn btn-sm btn-outline-primary mt-auto">View Details</a>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('../partials/pagination', { page, totalPages, baseUrl: '/projects', extraQuery: `&search=${search}&status=${statusFilter}` }) %>
