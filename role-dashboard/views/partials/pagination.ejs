<% if (totalPages > 1) { %>
<nav class="mt-3">
  <ul class="pagination">
    <% for (let p = 1; p <= totalPages; p++) { %>
      <li class="page-item <%= p === page ? 'active' : '' %>">
        <a class="page-link" href="<%= baseUrl %>?page=<%= p %><%= typeof extraQuery !== 'undefined' ? extraQuery : '' %>"><%= p %></a>
      </li>
    <% } %>
  </ul>
</nav>
<% } %>
