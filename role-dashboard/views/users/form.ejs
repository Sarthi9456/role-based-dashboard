<h3 class="mb-4"><%= user ? 'Edit User' : 'Add User' %></h3>

<div class="card shadow-sm" style="max-width: 560px;">
  <div class="card-body">
    <form action="<%= user ? `/users/${user.id}?_method=PUT` : '/users' %>" method="POST">
      <div class="mb-3">
        <label class="form-label">Full Name</label>
        <input type="text" name="name" class="form-control" value="<%= user ? user.name : '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" value="<%= user ? user.email : '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Role</label>
        <select name="roleId" class="form-select" required>
          <option value="">Select role...</option>
          <% roles.forEach(function(r) { %>
            <option value="<%= r.id %>" <%= user && Number(user.roleId) === r.id ? 'selected' : '' %>><%= r.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Password <% if (user) { %><small class="text-muted">(leave blank to keep unchanged)</small><% } %></label>
        <input type="password" name="password" class="form-control" <%= user ? '' : 'required' %> minlength="6">
      </div>
      <% if (user) { %>
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" name="isActive" id="isActive" <%= user.isActive ? 'checked' : '' %>>
          <label class="form-check-label" for="isActive">Active account</label>
        </div>
      <% } %>
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/users" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
