<div class="login-wrapper d-flex align-items-center justify-content-center">
  <div class="card shadow-sm login-card">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <i class="bi bi-kanban-fill fs-1 text-primary"></i>
        <h4 class="mt-2 mb-0">RBAC Dashboard</h4>
        <small class="text-muted">Sign in to continue</small>
      </div>

      <form action="/login" method="POST">
        <div class="mb-3">
          <label class="form-label">Email address</label>
          <input type="email" name="email" class="form-control" required autofocus placeholder="admin@example.com">
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary w-100">Login</button>
      </form>

      <p class="small text-muted text-center mt-3 mb-0">
        Don't have an account? <a href="/register">Sign up</a>
      </p>

      <hr>
      <p class="small text-muted mb-1">Demo accounts (seeded):</p>
      <ul class="small text-muted mb-0">
        <li>Admin &nbsp;— admin@example.com</li>
        <li>Manager — manager@example.com</li>
        <li>Employee — employee1@example.com</li>
      </ul>
      <p class="small text-muted mt-1 mb-0">Password: whatever is set as <code>SEED_DEFAULT_PASSWORD</code> (default <code>Password@123</code>)</p>
    </div>
  </div>
</div>